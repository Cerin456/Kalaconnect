# KalaConnect Environment Configuration
# Copy this file to .env.local for local overrides

# Node / Next.js
PORT=3000
NODE_ENV=production

# Security & Session Token Secret
SESSION_SECRET=kalaconnect-heritage-secret-key-super-secure-change-in-production

# Supabase (Optional: automatically active when provided)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Narrative Story Generation (Optional)
GEMINI_API_KEY=
